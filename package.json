{
  "name": "obsidian-mcp",
  "version": "0.1.0",
  "description": "MCP server that wraps the official Obsidian CLI",
  "type": "module",
  "bin": {
    "obsidian-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "inspect": "npx -y @modelcontextprotocol/inspector node dist/index.js",
    "test": "node scripts/chunk-test.mjs && node scripts/smoke-test.mjs && node scripts/confirm-test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18"
  }
}
